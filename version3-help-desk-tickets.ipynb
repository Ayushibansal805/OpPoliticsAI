   "cell_type": "code",
   "execution_count": 28,
   "id": "2fcfdf0b",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-28T13:30:24.946327Z",
     "iopub.status.busy": "2026-10-28T13:30:24.945884Z",
     "iopub.status.idle": "2026-10-28T13:30:24.978195Z",
     "shell.execute_reply": "2026-10-28T13:30:24.977585Z",
     "shell.execute_reply.started": "2026-10-28T13:30:24.946303Z"
    },
    "trusted": true
